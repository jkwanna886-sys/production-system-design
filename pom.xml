<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">


    <modelVersion>4.0.0</modelVersion>

    <groupId>design</groupId>
    <artifactId>production-system-design</artifactId>
    <version>1.0</version>

    <packaging>pom</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.3.2.RELEASE</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <modules>
        <module>ddd</module>
        <module>ds</module>
    </modules>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <connector.j.version>8.0.16</connector.j.version>
        <connector.mongo.version>4.11.0</connector.mongo.version>
        <connector.cassandra.version>4.19.0</connector.cassandra.version>
        <connector.h2.version>2.2.224</connector.h2.version>
        <org.rocksdb.version>9.0.0</org.rocksdb.version>
        <cache.redis.version>5.1.0</cache.redis.version>
        <session.redis.version>3.23.5</session.redis.version>
        <cache.memcache.version>2.12.3</cache.memcache.version>
        <big.spark.version>3.7.0</big.spark.version>
        <spring.crypto.version>5.8.2</spring.crypto.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <httpclient.version>4.5.13</httpclient.version>
        <grpc.version>1.68.0</grpc.version>
        <jwt.version>0.12.6</jwt.version>
        <kafka.version>4.0.0</kafka.version>
        <xz.version>1.8</xz.version>
        <compress.version>1.23.0</compress.version>
        <poi.version>5.2.3</poi.version>
        <easyexcel.version>3.0.5</easyexcel.version>
        <mybatis-plus.version>3.3.2</mybatis-plus.version>
        <jakarta.validation.version>2.0.1</jakarta.validation.version>
        <mybatis.spring.version>2.1.2</mybatis.spring.version>
        <collections4.version>4.4</collections4.version>
        <gson.version>2.8.8</gson.version>
        <guava.version>32.1.2-jre</guava.version>
        <lombok.version>1.18.22</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-boot-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>mysql</groupId>
            <artifactId>mysql-connector-java</artifactId>
            <version>${connector.j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.1</version>
        </dependency>

        <!-- If using AspectJ -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
        </dependency>

        <!-- MongoDB -->
<!--        <dependency>-->
<!--            <groupId>org.mongodb</groupId>-->
<!--            <artifactId>mongodb-driver-core</artifactId>-->
<!--            <version>${connector.mongo.version}</version>-->
